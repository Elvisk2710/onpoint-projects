# Copy to .env on each server and fill in. Never commit .env.

# Which site this backend belongs to: engineering | cleaning | security
SITE_KEY=engineering
SITE_NAME="OnPoint Civils"

# Public website address (used to build post links), no trailing slash
SITE_URL=https://www.onpointcivils.co.zw
# Where /admin, /api and /uploads are served. Usually the same as SITE_URL.
BACKEND_URL=https://www.onpointcivils.co.zw
# Public URL prefix for blog posts and projects on the website
BLOG_PATH=/blog
PROJECTS_PATH=/projects

# Admin accent colour
BRAND_COLOR=#f2b705

# Projects section (engineering only)
FEATURE_PROJECTS=true

# Database (one database per site)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=onpoint_engineering
DB_USER=onpoint
DB_PASS=change-me

# Optional: comma-separated origins allowed to call the API from a browser
# (only needed for local development, e.g. the Vite dev server)
CORS_ORIGINS=

# Optional: sender for new-message notification emails
MAIL_FROM=

# Long random string (16+ chars) used once by install.php; delete install.php afterwards
INSTALL_KEY=

UPLOAD_MAX_MB=15
APP_TIMEZONE=Africa/Harare
APP_DEBUG=false

# IndexNow: tells Bing (powers ChatGPT search, Copilot, DuckDuckGo) about new posts. Any 32 random letters/digits.
INDEXNOW_KEY=
