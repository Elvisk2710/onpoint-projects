# Uploaded files are data, never code
<FilesMatch "\.(?i:php\d?|phtml|phar|pl|py|cgi|sh|html?|svg|js)$">
  Require all denied
</FilesMatch>
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php5 .php7 .php8 .phar
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
</IfModule>
